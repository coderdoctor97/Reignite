# Gateway Control Center — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit real credentials to version control.

# ── Application ──────────────────────────────────────────────────
GCC_DEBUG=false

# ── Backend server ───────────────────────────────────────────────
GCC_BACKEND_HOST=127.0.0.1
GCC_BACKEND_PORT=8400

# ── Frontend URL (for CORS) ─────────────────────────────────────
GCC_FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────
# Default: <project_root>/data/gateway.db
# GCC_DATABASE_PATH=/path/to/gateway.db

# ── Logging ──────────────────────────────────────────────────────
# Levels: DEBUG, INFO, WARNING, ERROR
GCC_LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
GCC_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Legacy compatibility ─────────────────────────────────────────
# Path to the legacy Python scripts directory
# GCC_LEGACY_BASE_DIR=/path/to/legacy
